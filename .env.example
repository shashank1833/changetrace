CHANGETRACE_ENVIRONMENT=development
CHANGETRACE_DATABASE_URL=postgresql+psycopg://changetrace:change-me@localhost:5432/changetrace
CHANGETRACE_REDIS_URL=redis://localhost:6379/0
CHANGETRACE_QUEUE_MODE=inline
CHANGETRACE_ALLOWED_ORIGINS=http://localhost:5173
CHANGETRACE_LOCAL_REPOSITORY_ROOT=.
CHANGETRACE_SNAPSHOT_STORAGE_ROOT=.changetrace/snapshots
# Set to github to require authenticated sessions; development keeps header-based local access.
CHANGETRACE_AUTH_MODE=development
CHANGETRACE_GITHUB_CLIENT_ID=
CHANGETRACE_GITHUB_CLIENT_SECRET=
CHANGETRACE_GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
CHANGETRACE_WEB_URL=http://localhost:5173
CHANGETRACE_SESSION_SECRET=replace-with-at-least-32-random-characters
CHANGETRACE_SESSION_TTL_SECONDS=86400
CHANGETRACE_SESSION_COOKIE_SECURE=false
CHANGETRACE_GITHUB_APP_ID=
CHANGETRACE_GITHUB_APP_PRIVATE_KEY=
CHANGETRACE_GITHUB_WEBHOOK_SECRET=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
POSTGRES_PASSWORD=change-me
